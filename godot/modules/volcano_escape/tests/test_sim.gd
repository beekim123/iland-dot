extends SceneTree
const Sim = preload("../sim.gd")
const Island = preload("../data/island.gd")
const Witness = preload("../data/witness.gd")
var assertions := 0
var failures := 0
func expect(ok: bool,label: String) -> void:
	assertions+=1
	if not ok: failures+=1; printerr("FAIL ",label)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	for script_id in 3:
		for exit_id in ["boat","balloon","airship"]:
			for window in 2:
				var sim=Sim.new(); sim.start(script_id)
				expect(Witness.escape(sim,exit_id,window),"witness %s/%s/%s"%[script_id,exit_id,window])
				expect(sim.health==3 and sim.lit_beacons.is_empty(),"safe route no optional prerequisites")
				print("WITNESS ",script_id," ",exit_id," window ",window," time ",sim.time," health ",sim.health)
			var alternate=Sim.new(); alternate.start(script_id)
			expect(Witness.escape(alternate,exit_id,0,true),"alternate route")
			var late=Sim.new(); late.start(script_id); Witness.wait_until(late,224)
			expect(Witness.escape(late,exit_id,1),"late departure through already closed-road map")
			expect(late.health==3,"late route avoids scheduled hazards at normal speed")
	_test_rules()
	_test_hazards()
	_test_moving_interaction()
	_test_score_and_geometry()
	_test_schedule_edges()
	_test_independent_counterexamples()
	print("VOLCANO SIM: ",assertions," assertions; ",failures," failures")
	quit(0 if failures==0 else 1)
func _test_rules() -> void:
	var sim=Sim.new(); sim.start()
	expect(sim.map_data.nodes.size()==12 and sim.map_data.roads.size()==18 and sim.map_data.shelters.size()==6,"content counts")
	for road: Dictionary in sim.map_data.roads:
		if road.closes_at>0: expect(is_equal_approx(road.closes_at-road.warns_at,20),"road lead")
	for shelter: Dictionary in sim.map_data.shelters: expect(is_equal_approx(shelter.expires_at-shelter.warns_at,30),"shelter lead")
	for rock: Dictionary in sim.map_data.rocks: expect(is_equal_approx(rock.impact_at-rock.warns_at,4),"rock lead")
	sim.command({"pause":true}); var frozen=sim.snapshot(); sim.tick(200)
	expect(sim.snapshot()==frozen,"pause all clocks")
	sim.command({"pause":false,"move":Vector2(1,1)}); sim.tick(8)
	expect(sim._walkable(sim.pos),"continuous diagonal collision")
	expect(not sim._segment_clear(Island.NODES.E,Island.NODES.L),"cannot tunnel across gaps")
	sim.start(); expect(Witness.drive(sim,["F","C"]),"reach balloon")
	Witness.wait_until(sim,135.1); Witness.press(sim,5.0)
	expect(sim.status=="running" and sim.interaction.progress==0.0,"release resets balloon")
	sim.command({"interact":true}); sim.tick(3); sim.command({"move":Vector2(0,1)}); sim.tick(0.05)
	expect(sim.interaction.kind=="","move cancels held operation")
	sim.command({"move":Vector2.ZERO}); sim.tick(7)
	expect(sim.status=="running","held key does not restart without edge")
	Witness.press(sim,6.1); expect(sim.status=="success","fresh E complete")
	sim.start(); expect(Witness.drive(sim,["D"]),"reach shelter")
	Witness.press(sim); expect(sim.shelter_id=="shelter_D","enter shelter")
	sim.command({"interact":true}); sim.tick(0.1)
	expect(sim.shelter_id=="","fresh edge leaves")
	sim.tick(1); expect(sim.shelter_id=="","held E no reentry")
	Witness.press(sim); Witness.wait_until(sim,190)
	expect(sim.shelter_id=="","expiry ejects")
	Witness.wait_until(sim,330.1); expect(sim.status=="rescued" and sim.result.reason=="timeout","permanent camp cannot win")

func _test_hazards() -> void:
	var sim=Sim.new(); sim.start()
	sim.command({"move":Vector2(0,1)}); sim.tick(8.0/2.8)
	Witness.wait_until(sim,40.2)
	expect(sim.health==2,"warned center rock deals exactly one")
	Witness.wait_until(sim,41.19); expect(sim.health==2,"same rock deduplicated")
	var warnings: Array=sim.drain_events().filter(func(e): return e.type=="rock_warning" and e.id=="rock_00")
	expect(warnings.size()==1 and absf(warnings[0].time-36)<0.018,"actual four-second warning event")
	sim.start(); sim.command({"move":Vector2(0,1)}); sim.tick(8.0/2.8)
	sim.command({"move":Vector2(1,0)}); sim.tick(1.4/2.8)
	Witness.wait_until(sim,41.3); expect(sim.health==3,"rock avoided by visible road sidestep")
	sim.start(); expect(Witness.drive(sim,["D"]),"shelter hazard route")
	Witness.press(sim); Witness.wait_until(sim,71.3)
	expect(sim.health==3 and sim.shelter_id=="shelter_D","artificial shelter actually blocks rock")
	sim.command({"move":Vector2(1,0)}); sim.tick(0.1)
	expect(sim.shelter_id=="" and sim.pos.x>-18,"direction leaves shelter")
	sim.start(); Witness.drive(sim,["D"]); Witness.wait_until(sim,116)
	var visited: Vector2=sim.checkpoint
	sim.command({"move":Vector2(0,1)}); sim.tick(1.2)
	expect(sim.health==1 and sim.checkpoint.distance_to(visited)<0.5 and sim.pos.distance_to(sim.checkpoint)<1.0,"lava returns actually visited checkpoint (prior rock plus lava)")
	sim.tick(0.5); expect(sim.health==1,"immediate repeated lava contact protected")
	sim.tick(2.5); expect(sim.status=="rescued","later separate lava contact damages again")
	sim.start(); Witness.drive(sim,["D"]); Witness.wait_until(sim,70.2)
	expect(sim.health==2,"first distinct rock")
	Witness.drive(sim,["E","F"]); Witness.wait_until(sim,130.2)
	expect(sim.health==1,"second distinct rock")
	Witness.drive(sim,["I","L"]); Witness.wait_until(sim,160.2)
	expect(sim.status=="rescued" and sim.result.reason=="health" and sim.health==0,"three hazards produce rescue")

func _test_moving_interaction() -> void:
	var sim=Sim.new(); sim.start(); Witness.drive(sim,["F","C"]); Witness.wait_until(sim,135.1)
	var start: Vector2=sim.pos
	sim.command({"move":Vector2(0,1),"interact":true}); sim.tick(3)
	expect(sim.pos.is_equal_approx(start) and sim.interaction.progress>2.9,"move plus E edge parks and starts balloon")
	sim.command({"move":Vector2(0,1),"interact":true}); sim.tick(0.5)
	expect(sim.interaction.progress>3.4,"unchanged held direction preserves operation")
	sim.command({"move":Vector2(1,0),"interact":true}); sim.tick(0.05)
	expect(sim.interaction.kind=="" and sim.pos.x>start.x,"new direction cancels and moves")
	sim.command({"move":Vector2.ZERO,"interact":false}); sim.tick(0.01)
	Witness.wait_until(sim,172); Witness.press(sim,6.1)
	expect(sim.status=="running" and sim.interaction.kind=="","late balloon window cannot finish outside window")
	Witness.wait_until(sim,250.1); Witness.press(sim,6.1)
	expect(sim.status=="success","second window recovers missed first")
	sim.start(); Witness.drive(sim,["H","G","J"])
	sim.command({"move":Vector2(0,1),"interact":true}); sim.tick(1.1)
	expect(sim.called_at>0 and sim.arrives_at-sim.called_at==12.0,"moving call stops for one second and schedules arrival")
	Witness.wait_until(sim,145.1); sim.command({"interact":true}); sim.tick(0.1)
	expect(sim.status=="success","called arrived airship boards only in window")

func _test_score_and_geometry() -> void:
	var sim=Sim.new(); sim.start()
	Witness.drive(sim,["H"]); sim.command({"move":Vector2(1,0)}); sim.tick(0.5/2.8)
	Witness.press(sim); expect(sim.score==100 and sim.lit_beacons.size()==1,"earned optional beacon score")
	sim.command({"interact":true}); sim.tick(3); expect(sim.score==100,"beacon score cannot duplicate")
	var detached: Dictionary=sim.snapshot(); detached.map.nodes.E=Vector2(99,99)
	expect(sim.map_data.nodes.E==Vector2(0,-8),"snapshot does not mutate authority")
	sim.start()
	for point in [Vector2(9,0),Vector2(-9,0),Vector2(9,16),Vector2(-9,16)]:
		# EI is the only diagonal and intentionally covers (9,0).
		expect(sim._walkable(point)==(point==Vector2(9,0)),"union preserves graph holes")
	expect(sim._segment_clear(Island.NODES.E,Island.NODES.I),"authoritative diagonal is continuous")
	Witness.wait_until(sim,251)
	expect(not sim._segment_clear(Island.NODES.E,Island.NODES.I),"closed diagonal cannot tunnel")
	var cpu_start := Time.get_ticks_usec()
	for i in 2000:
		sim.command({"move":Vector2(1 if (i/100)%2==0 else -1,0)})
		sim.tick(1.0/60.0)
	print("SIM CPU late-game average usec/tick=",(Time.get_ticks_usec()-cpu_start)/2000.0)
	expect(sim.status=="running" and sim.health==3,"late-game moving performance scenario remains valid")

func _test_schedule_edges() -> void:
	for script_id in 3:
		var sim=Sim.new(); sim.start(script_id)
		Witness.wait_until(sim,94.99)
		var first: Array=sim.snapshot().roads.filter(func(r): return r.closes_at==115.0)
		expect(first.size()==1 and first[0].state=="open","prewarning road state")
		Witness.wait_until(sim,95.01)
		first=sim.snapshot().roads.filter(func(r): return r.closes_at==115.0)
		expect(first[0].state=="warning","road warning transition")
		Witness.wait_until(sim,115.01)
		first=sim.snapshot().roads.filter(func(r): return r.closes_at==115.0)
		expect(first[0].state=="closed","road closure transition")
		Witness.wait_until(sim,135.01)
		var shelters: Array=sim.snapshot().shelters.filter(func(r): return r.expires_at==165.0)
		expect(shelters[0].state=="warning","shelter 30s warning transition")
		Witness.wait_until(sim,165.01)
		shelters=sim.snapshot().shelters.filter(func(r): return r.expires_at==165.0)
		expect(shelters[0].state=="expired","shelter expiry transition")
	var sim=Sim.new(); sim.start(); Witness.drive(sim,["H","G","J"]); Witness.wait_until(sim,144)
	Witness.press(sim,1.1); Witness.press(sim)
	expect(sim.status=="running","open window alone cannot board before arrival")
	Witness.wait_until(sim,157); Witness.press(sim); expect(sim.status=="success","arrival permits fresh-edge boarding")
	var end: Dictionary=sim.snapshot(); sim.tick(300)
	expect(sim.snapshot()==end,"terminal results immutable")
	sim.start(); Witness.drive(sim,["F","C"]); Witness.wait_until(sim,135.1)
	sim.command({"interact":true}); sim.tick(2)
	sim.command({"pause":true}); var frozen: Dictionary=sim.snapshot(); sim.tick(100)
	expect(sim.snapshot()==frozen,"pause freezes held operation and window")
	sim.command({"pause":false}); sim.tick(4.1)
	expect(sim.status=="success","resumed operation retains exactly earned progress")

func _test_independent_counterexamples() -> void:
	var sim=Sim.new(); sim.start()
	sim.tick(NAN); expect(sim.time==0,"NaN dt ignored")
	sim.tick(INF); expect(sim.time==0,"infinite dt ignored")
	Witness.wait_until(sim,329.99); sim.tick(0.01)
	expect(sim.status=="rescued" and sim.time==330.0,"exact 330 boundary terminates despite accumulated rounding")
	sim.start()
	for point in [Vector2(4.5,-6.0),Vector2(13.5,6.0)]:
		expect(not sim._walkable(point),"acute EI junction rejects independently proven leaking disk")
	expect(not sim._segment_clear(Vector2(4.5,-6.5),Vector2(4.5,-6.0)),"swept actor cannot reach leaking acute-junction position")

	sim.start(); Witness.drive(sim,["D"]); Witness.wait_until(sim,114)
	sim.command({"move":Vector2(0,1)}); sim.tick(1.0)
	sim.command({"move":Vector2.ZERO}); sim.tick(0.02)
	expect(sim._walkable(sim.pos) and sim.health==1,"closing road resolves full-body hub-edge overlap to visited checkpoint")

	for script_id in 3:
		sim.start(script_id); Witness.wait_until(sim,241)
		expect(not sim._walkable(Vector2(-6.5,21.0)),"opened graph cycle cannot leave phantom filled source-union gap")
